# Template only: placeholders, no real values. Copy to `.env` (gitignored) and fill in; never commit real credentials.
#
# Lookup order for the Neo4j graph backend (src/skillllm_v2/graph/store_settings.py):
#   1. real environment variables (always win),
#   2. the nearest `.env` found walking UP from the current working directory and from the installed package location
#      (a nearer file wins per key; a key absent from it can come from a farther one, up to the filesystem root).
# So ONE global `.env` in the repository root serves every sub-project; a `.env` next to a sub-project overrides it.
#
# Only these four keys are read from a `.env` file. TLS is mandatory: the URI must start with neo4j+s:// (or bolt+s://).
NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USERNAME=<your-username>
NEO4J_PASSWORD=<your-password>
NEO4J_DATABASE=<your-database-name>
