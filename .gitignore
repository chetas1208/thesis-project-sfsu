# Local credentials and environment overrides. Keep only redacted templates.
.env
.env.*
!.env.example
!.env.example.*

# Python environments, caches, and generated bytecode.
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.cache/

# Runtime logs and local process state.
*.log
*.pid
**/logs/

# Downloaded/generated model state and experiment outputs. These are large,
# machine-specific, and reproducible from the checked-in scripts/configs.
**/models
**/outputs
**/results
**/checkpoints
**/artifacts

# Runtime demo reports; checked-in research snapshots remain trackable.
**/reports/**/end_to_end_demo.json

# Local/private resume corpus and derived files.
Experiments/data/
SkillLLM_v2/Extract_jobDesc/data/

# Bundled runtime downloads and build leftovers.
SkillLLM_v2/Extract_jobDesc/libs/
SkillLLM_v2/Extract_jobDesc/pip_out.txt
SkillLLM_v2/Extract_jobDesc/=[0-9]*

# LaTeX build intermediates (the source and final PDF remain trackable).
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.toc

# Editor and OS metadata.
.DS_Store
.idea/
